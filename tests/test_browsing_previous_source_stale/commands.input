CXREF -server
-getproject CURDIR/source.c
<sync>
-browse-push -preload CURDIR/source.c CURDIR/source.preload -preload CURDIR/header.h CURDIR/header.preload -cursor=50 CURDIR/source.c
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -preload CURDIR/header.h CURDIR/header.preload -cursor=39 CURDIR/header.h
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -preload CURDIR/header.h CURDIR/header.preload -cursor=90 CURDIR/header.h
<sync>
-browse-previous -preload CURDIR/source.c CURDIR/source.modified -preload CURDIR/header.h CURDIR/header.preload -cursor=50 CURDIR/source.c
<sync>
<exit>
