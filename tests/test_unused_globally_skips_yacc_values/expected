CXREF -xrefactory-II -server -o server-buffer
-getproject CURDIR/grammar.y
end-of-options

<sync>
<set-info len=<n>>CURDIR</set-info>
-olcxpushglobalunused CURDIR/grammar.y
end-of-options

<sync>
<wait-confirmation len=<n>>1 of 1 compilation units need reparsing. Parse all before checking for unused?</wait-confirmation>
-continue
end-of-options

<sync>
<display-or-update-browser len=<n>></display-or-update-browser>
-olcxmenufilter=2
end-of-options

<sync>
<resolution>
 <symbol line=2 selected=1 base=0 drefn=1 refn=0 len=<n>>term</symbol>
 <symbol line=3 selected=1 base=0 drefn=1 refn=0 len=<n>>unused_globally</symbol>
 <symbol line=4 selected=1 base=0 drefn=1 refn=0 len=<n>>.number</symbol>
</resolution>
-exit
end-of-options

