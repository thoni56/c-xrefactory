CXREF -server
-getproject CURDIR/source.c
<sync>
-browse-push  -cursor=68 CURDIR/source.c  -p CURDIR
<sync>
-browse-push  -cursor=68 CURDIR/source.c  -p CURDIR
<sync>
-browse-next  -cursor=68 CURDIR/source.c  -p CURDIR -preload CURDIR/source.c CURDIR/source.preload
<sync>
-browse-pop  -cursor=68 CURDIR/source.c  -p CURDIR
<sync>
-browse-next  -cursor=68 CURDIR/source.c  -p CURDIR
<sync>
<exit>
