CXREF -server
-getproject CURDIR/source.c
<sync>
-rfct-del-param -parameter=1 -mark=0 -cursor=30 CURDIR/source.c
<sync>
!cp CURDIR/source.c.parameter_deleted CURDIR/source.c
!cp CURDIR/source.c.line_removed CURDIR/source.c
-rfct-del-param -parameter=1 -mark=0 -cursor=68 CURDIR/source.c
<sync>
<exit>
