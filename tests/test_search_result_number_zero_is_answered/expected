CXREF -server -o server-buffer
-getproject CURDIR/source.c
end-of-options

<sync>
<set-info len=<n>>CURDIR</set-info>
-search=int* -cursor-line-column=1:5 -cursor=5 CURDIR/source.c -cursor=85
end-of-options

<sync>
<symbol-list>
 <str len=<n>>int_which_is_public :source.c :CURDIR/source.c</str>
 <str len=<n>>int_which_is_static :source.c :CURDIR/source.c</str>
</symbol-list>
-search-goto=0
end-of-options

<sync>
<error len=<n>>There is no search result number 0
</error>
-search-select=0
end-of-options

<sync>
<error len=<n>>There is no search result number 0
</error>
-search-goto=1
end-of-options

<sync>
<goto>
 <position-lc line=1 col=5 len=<n>>CURDIR/source.c</position-lc>
</goto>
-exit
end-of-options

