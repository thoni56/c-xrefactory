CXREF -server
-getproject CURDIR/source.c
<sync>
-browse-push -cursor=6 CURDIR/source.c
<sync>
-browse-next -cursor=4 CURDIR/source.c
<sync>
-browse-next -cursor=62 CURDIR/source.c
<sync>
-getproject CURDIR/source.c
<sync>
-browse-push -preload CURDIR/source.c CURDIR/source.preload -cursor=6 CURDIR/source.c
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -cursor=4 CURDIR/source.c
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -cursor=45 CURDIR/source.c
<sync>
-browse-pop -preload CURDIR/source.c CURDIR/source.preload -cursor=6 CURDIR/source.c
<sync>
-browse-push -preload CURDIR/source.c CURDIR/source.preload -cursor=6 CURDIR/source.c
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -cursor=4 CURDIR/source.c
<sync>
<exit>
