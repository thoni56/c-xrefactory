CXREF -xrefactory-II -crlfconversion -crconversion -server
-getproject CURDIR/source.c
<sync>
CXREF -xref -xrefactory-II -crlfconversion -crconversion -fastupdate -errors
-push -olcursor=6 CURDIR/source.c
<sync>
-browse-next -olcursor=4 CURDIR/source.c
<sync>
-browse-next -olcursor=62 CURDIR/source.c
<sync>
-getproject CURDIR/source.c
<sync>
CXREF -xref -xrefactory-II -crlfconversion -crconversion -fastupdate -errors -preload CURDIR/source.c CURDIR/source.preload
-push -preload CURDIR/source.c CURDIR/source.preload -olcursor=6 CURDIR/source.c
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -olcursor=4 CURDIR/source.c
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -olcursor=45 CURDIR/source.c
<sync>
-olcxpop -preload CURDIR/source.c CURDIR/source.preload -olcursor=6 CURDIR/source.c
<sync>
-push -preload CURDIR/source.c CURDIR/source.preload -olcursor=6 CURDIR/source.c
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -olcursor=4 CURDIR/source.c
<sync>
<exit>
