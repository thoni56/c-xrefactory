CXREF -server -o server-buffer
-getproject CURDIR/source.c
end-of-options

<sync>
<set-info len=<n>>CURDIR</set-info>
-browse-push -preload CURDIR/source.c CURDIR/source.preload -cursor=50 CURDIR/source.c
end-of-options

