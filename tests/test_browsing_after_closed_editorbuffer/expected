 <position-lc line=1 col=4 len=<n>>CURDIR/header.h</position-lc>
</goto>
-browse-next -preload CURDIR/header.h CURDIR/header.preload -cursor=6 CURDIR/header.h
end-of-options

<sync>
<goto>
 <position-lc line=4 col=11 len=<n>>CURDIR/source.c</position-lc>
</goto>
-exit
end-of-options

