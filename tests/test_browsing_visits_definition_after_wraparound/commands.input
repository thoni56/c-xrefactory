CXREF -xrefactory-II -server
-getproject CURDIR/source1.c
<sync>
-push -preload CURDIR/common.h CURDIR/common.preload -olcursor=35 CURDIR/common.h
<sync>
-browse-next -preload CURDIR/common.h CURDIR/common.preload -olcursor=32 CURDIR/common.h
<sync>
-browse-next -preload CURDIR/source1.c CURDIR/source1.preload -olcursor=22 CURDIR/source1.c
<sync>
-browse-next -preload CURDIR/source2.c CURDIR/source2.preload -olcursor=22 CURDIR/source2.c
<sync>
-browse-next -preload CURDIR/source3.c CURDIR/source3.preload -olcursor=22 CURDIR/source3.c
<sync>
<exit>
