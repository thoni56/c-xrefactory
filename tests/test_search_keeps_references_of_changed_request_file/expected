CXREF -server -o server-buffer
-getproject CURDIR/a.c
end-of-options

<sync>
<set-info len=<n>>CURDIR</set-info>
-push -olcursor=4 CURDIR/a.c
end-of-options

<sync>
<goto>
 <position-lc line=1 col=4 len=<n>>CURDIR/a.c</position-lc>
</goto>
shell: cp CURDIR/a.v2 CURDIR/a.c
-search=f -olcursor=1 CURDIR/a.c
end-of-options

<sync>
<symbol-list>
 <str len=<n>>f :a.c :CURDIR/a.c</str>
</symbol-list>
-exit
end-of-options

