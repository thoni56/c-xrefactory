CXREF -xrefactory-II -server
-getproject CURDIR/source1.c
<sync>
-push -preload CURDIR/common.h CURDIR/common.preload1 -olcursor=35 CURDIR/common.h
<sync>
-browse-next -preload CURDIR/common.h CURDIR/common.preload2 -olcursor=32 CURDIR/common.h
<sync>
-browse-next -olcursor=22 CURDIR/source1.c
<sync>
-browse-next -olcursor=22 CURDIR/source2.c
<sync>
-browse-next -olcursor=22 CURDIR/source3.c
<sync>
<exit>
