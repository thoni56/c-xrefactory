<sync>
-browse-next -preload CURDIR/a.c CURDIR/a.preload -preload CURDIR/common.h CURDIR/common.preload -cursor=44 CURDIR/a.c
<sync>
-browse-next -preload CURDIR/a.c CURDIR/a.preload -preload CURDIR/common.h CURDIR/common.modified -cursor=44 CURDIR/b.c
