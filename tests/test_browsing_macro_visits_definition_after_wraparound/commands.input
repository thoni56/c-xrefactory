CXREF -server
-getproject CURDIR/source1.c
<sync>
-browse-push -preload CURDIR/common.h CURDIR/common.preload -cursor=8 CURDIR/common.h
<sync>
-browse-next -preload CURDIR/common.h CURDIR/common.preload -cursor=8 CURDIR/common.h
<sync>
-browse-next -preload CURDIR/source1.c CURDIR/source1.preload -cursor=30 CURDIR/source1.c
<sync>
-browse-next -preload CURDIR/source2.c CURDIR/source2.preload -cursor=30 CURDIR/source2.c
<sync>
-browse-next -preload CURDIR/source3.c CURDIR/source3.preload -cursor=30 CURDIR/source3.c
<sync>
<exit>
