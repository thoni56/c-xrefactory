CXREF -xrefactory-II -crlfconversion -crconversion -server
-getproject CURDIR/source.c
<sync>
-push  -olcursor=68 CURDIR/source.c
<sync>
-browse-next  -olcursor=5 CURDIR/source.c  -preload CURDIR/source.c CURDIR/source.preload
<sync>
-browse-next  -olcursor=68 CURDIR/source.c  -preload CURDIR/source.c CURDIR/source.preload
<sync>
<exit>
