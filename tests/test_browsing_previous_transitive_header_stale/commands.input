CXREF -server
-getproject CURDIR/source.c
<sync>
-browse-push -preload CURDIR/source.c CURDIR/source.preload -preload CURDIR/inner.h CURDIR/inner.preload -cursor=48 CURDIR/source.c
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -preload CURDIR/inner.h CURDIR/inner.preload -cursor=37 CURDIR/inner.h
<sync>
-browse-next -preload CURDIR/source.c CURDIR/source.preload -preload CURDIR/inner.h CURDIR/inner.preload -cursor=88 CURDIR/inner.h
<sync>
-browse-previous -preload CURDIR/source.c CURDIR/source.preload -preload CURDIR/inner.h CURDIR/inner.modified -cursor=48 CURDIR/source.c
<sync>
<exit>
