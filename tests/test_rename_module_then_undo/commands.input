CXREF -server
-getproject CURDIR/main.c
<sync>
-rfct-rename-module -renameto=target -cursor=10 CURDIR/main.c
<sync>
!cp CURDIR/main.c.original CURDIR/main.c
!cp CURDIR/source.c.original CURDIR/source.c
!cp CURDIR/source.h.original CURDIR/source.h
!rm -f CURDIR/target.c CURDIR/target.h
-browse-push -cursor=0 CURDIR/main.c
<sync>
<exit>
