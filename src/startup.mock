/* -*- c -*-*/
#include "startup.h"
#include <cgreen/mocks.h>

void totalTaskEntryInitialisations(void) {
  mock();
}

void mainTaskEntryInitialisations(ArgumentsVector args, StringList **operands) {
  mock(args.argc, args.argv, operands);
}

bool initializeProjectContext(char *fileName, ArgumentsVector startupOptions,
                              ArgumentsVector requestOptions) {
  return (bool)mock(fileName, startupOptions.argc, startupOptions.argv,
                    requestOptions.argc, requestOptions.argv);
}

bool initializeFileProcessing(ArgumentsVector args, ArgumentsVector nargs, char *fileName) {
    return (bool)mock(args.argc, args.argv, nargs.argc, nargs.argv, fileName);
}

void startCompilationUnit(void) {
    mock();
}

int numberOfPasses(void) {
    return (int)mock();
}

void saveProjectBaseline(void) {
    mock();
}

void startCompilationUnitForPass(int pass) {
    mock(pass);
}

bool isProjectConfigChanged(void) {
    return (bool)mock();
}

void reloadProjectConfig(ArgumentsVector startupOptions, ArgumentsVector requestOptions) {
    mock();
}

static ProjectConfig mockProjectConfig = {0};

ProjectConfig *getProjectConfig(void) {
    return &mockProjectConfig;
}
