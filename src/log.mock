#include <cgreen/mocks.h>
#include <stdarg.h>
#include <stdio.h>

typedef enum {
    LOG_DEBUG, LOG_TRACE, LOG_INFO, LOG_WARN, LOG_ERROR, LOG_FATAL
} LogLevel;


void log_set_level(int level) {
}

void log_indent(void) {}
void log_outdent(void) {}

/* A warning, an error or a fatal is something a test expects, or it fails */
void log_log(LogLevel level, const char *file, int line, const char *fmt, ...) {
    if (level < LOG_WARN)
        return;
    char message[1000];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(message, sizeof(message), fmt, ap);
    va_end(ap);
    mock(level, message);
}
