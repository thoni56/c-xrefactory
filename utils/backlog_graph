#!/usr/bin/env python3
#
# Draw doc/backlog.md as an anatomy: a Mermaid flowchart read bottom-up, where an
# item sits above what it waits for.
#
# An item is a numbered line with an anchor and a bold title,
#     2. <a id="second-item"></a>**Second item** — ...
# and what it waits for is a line of slugs below it,
#        Waits for: first-item

import base64
import json
import re
import sys
import zlib

SECTION = re.compile(r'^## (\d+)\. (.+)$')
ITEM = re.compile(r'^(\d+)\. <a id="([^"]+)"></a>\*\*(.+?)\*\*')
SUBITEM = re.compile(r'^\s+([a-z])\. <a id="([^"]+)"></a>\*\*(.+?)\*\*')
WAITS = re.compile(r'^\s*Waits for:\s*(.+)$')
GOES_WITH = re.compile(r'^\s*Goes with:\s*(.+)$')
FOUNDATION = re.compile(r'^## Foundation\s*$')
DONE = re.compile(r'^- <a id="([^"]+)"></a>\*\*(.+?)\*\*')


def node_id(slug):
    return slug.replace('-', '_')


def label(text):
    # Quotes would end the label, and Mermaid reads <...> as HTML
    return '"' + text.replace('"', '#quot;').replace('<', '#lt;').replace('>', '#gt;') + '"'


def new_item(number, slug, title, section):
    return {'number': number, 'slug': slug, 'title': title, 'section': section,
            'waits': [], 'goes_with': [], 'parts': []}


def read_backlog(lines):
    sections = []
    items = {}
    foundation = []
    current = None
    in_foundation = False
    for line in lines:
        m = SECTION.match(line)
        if m:
            sections.append({'id': f"section_{m.group(1)}", 'number': m.group(1),
                             'title': m.group(2), 'items': []})
            in_foundation = False
            continue
        if FOUNDATION.match(line):
            in_foundation = True
            continue
        m = DONE.match(line)
        if m and in_foundation:
            foundation.append({'slug': m.group(1), 'title': m.group(2)})
            continue
        m = ITEM.match(line)
        if m:
            current = new_item(m.group(1), m.group(2), m.group(3), sections[-1]['number'])
            parent = current
            items[current['slug']] = current
            sections[-1]['items'].append(current)
            continue
        m = SUBITEM.match(line)
        if m:
            current = new_item(parent['number'] + m.group(1), m.group(2), m.group(3),
                               parent['section'])
            items[current['slug']] = current
            parent['parts'].append(current)
            continue
        m = WAITS.match(line)
        if m and current is not None:
            current['waits'] += [s.strip() for s in m.group(1).split(',')]
            continue
        m = GOES_WITH.match(line)
        if m and current is not None:
            current['goes_with'] += [s.strip() for s in m.group(1).split(',')]
    return sections, items, foundation


HEADER = ["flowchart BT",
          "  classDef ready fill:#9fd4a8,stroke:#4f9a5d,color:#13261a",
          "  classDef blocked fill:#f1c48b,stroke:#b9853f,color:#2b1d08",
          "  classDef done fill:#c9d3cb,stroke:#8a958c,color:#1f2421"]


def node_lines(work, foundation):
    lines = []
    for item in work:
        text = f"§{item['section']} · {item['number']} · {item['title']}"
        lines.append(f"  {node_id(item['slug'])}[{label(text)}]")
    for done in foundation:
        lines.append(f"  {node_id(done['slug'])}[{label(done['title'])}]")
    return lines


def edge_lines(work):
    waits = [f"  {node_id(waited)} --> {node_id(item['slug'])}"
             for item in work for waited in item['waits']]
    goes_with = [f"  {node_id(item['slug'])} -.- {node_id(other)}"
                 for item in work for other in item['goes_with']]
    lines = waits + goes_with
    # Goes with is not waits for, so it must not look like it even when drawn small
    if goes_with:
        indexes = ','.join(str(i) for i in range(len(waits), len(lines)))
        lines.append(f"  linkStyle {indexes} stroke:#8a63d2,stroke-width:2px,stroke-dasharray:6 4")
    return lines


def state_lines(work, items, foundation):
    lines = []
    for item in work:
        state = 'blocked' if any(w in items for w in item['waits']) else 'ready'
        lines.append(f"  class {node_id(item['slug'])} {state}")
    for done in foundation:
        lines.append(f"  class {node_id(done['slug'])} done")
    return lines


def draw(sections, items, foundation):
    # A dependency graph and nothing else: every item and the foundation are drawn,
    # and the section an item belongs to is a tag in its label, not a box
    work = [item for item in items.values() if not item['parts']]
    return (HEADER + node_lines(work, foundation) + edge_lines(work)
            + state_lines(work, items, foundation))


GRAPH_START = "<!-- graph start -->"
GRAPH_END = "<!-- graph end -->"


def without_graph(text):
    if GRAPH_START not in text:
        return text
    before, rest = text.split(GRAPH_START, 1)
    after = rest.split(GRAPH_END, 1)[1]
    return before.rstrip('\n') + '\n' + after.lstrip('\n')


def graph_of(text):
    sections, items, foundation = read_backlog(text.split('\n'))
    return '\n'.join(draw(sections, items, foundation))


def mermaid_live_link(graph):
    # The diagram travels in the part after '#', which the browser keeps to itself
    state = json.dumps({"code": graph, "mermaid": '{"theme": "default"}',
                        "autoSync": True, "updateDiagram": True})
    packed = base64.urlsafe_b64encode(zlib.compress(state.encode(), 9)).decode().rstrip('=')
    return "https://mermaid.live/view#pako:" + packed


def with_graph(text):
    text = without_graph(text)
    graph = graph_of(text)
    # Only the link: GitHub's own Mermaid lays the graph out in a way that can mislead
    return (text.rstrip('\n') + '\n\n' + GRAPH_START + '\n'
            + f'[Open the dependency graph]({mermaid_live_link(graph)}), drawn from the '
            + '`Waits for:` and `Goes with:` lines above.\n'
            + 'It opens in a window of its own, at mermaid.live.\n' + GRAPH_END + '\n')


def problems_in(path, text):
    sections, items, foundation = read_backlog(without_graph(text).split('\n'))
    known = set(items) | {done['slug'] for done in foundation}
    found = []
    for item in items.values():
        for waited in item['waits']:
            if waited not in known:
                found.append(f"{path}: {item['slug']} waits for {waited}, which is not in the backlog")
        for other in item['goes_with']:
            if other not in known:
                found.append(f"{path}: {item['slug']} goes with {other}, which is not in the backlog")
    if with_graph(text) != text:
        found.append(f"{path}: the graph is out of date, run utils/backlog_graph --update {path}")
    return found


if __name__ == "__main__":
    if sys.argv[1] == '--check':
        with open(sys.argv[2]) as f:
            found = problems_in(sys.argv[2], f.read())
        for problem in found:
            print(problem)
        sys.exit(1 if found else 0)
    elif sys.argv[1] == '--update':
        with open(sys.argv[2]) as f:
            text = f.read()
        with open(sys.argv[2], 'w') as f:
            f.write(with_graph(text))
    else:
        with open(sys.argv[1]) as f:
            print(graph_of(without_graph(f.read())))
