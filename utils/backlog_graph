#!/usr/bin/env python3
#
# Draw doc/backlog.md as an anatomy: a Mermaid flowchart read bottom-up, where an
# item sits above what it waits for.
#
# An item is a list entry with its number, an anchor and a bold title,
#     - (#2) <a id="second-item"></a>**Second item** — ...
# and what it waits for is a line of slugs below it,
#        Waits for: first-item

import html
import re
import sys

SECTION = re.compile(r'^## (\d+)\. (.+)$')
ITEM = re.compile(r'^- \(#(\d+)\) <a id="([^"]+)"></a>\*\*(.+?)\*\*')
SUBITEM = re.compile(r'^\s+([a-z])\. <a id="([^"]+)"></a>\*\*(.+?)\*\*')
WAITS = re.compile(r'^\s*Waits for:\s*(.+)$')
GOES_WITH = re.compile(r'^\s*Goes with:\s*(.+)$')
FOUNDATION = re.compile(r'^## Foundation\s*$')
DONE = re.compile(r'^- <a id="([^"]+)"></a>\*\*(.+?)\*\*')


def node_id(slug):
    return slug.replace('-', '_')


def label(text):
    # Quotes would end the label, and Mermaid reads <...> as HTML
    return '"' + text.replace('"', '#quot;').replace('<', '#lt;').replace('>', '#gt;') + '"'


def new_item(number, slug, title, section):
    return {'number': number, 'slug': slug, 'title': title, 'section': section,
            'waits': [], 'goes_with': [], 'parts': []}


def read_backlog(lines):
    sections = []
    items = {}
    foundation = []
    current = None
    in_foundation = False
    for line in lines:
        m = SECTION.match(line)
        if m:
            sections.append({'id': f"section_{m.group(1)}", 'number': m.group(1),
                             'title': m.group(2), 'items': []})
            in_foundation = False
            continue
        if FOUNDATION.match(line):
            in_foundation = True
            continue
        m = DONE.match(line)
        if m and in_foundation:
            foundation.append({'slug': m.group(1), 'title': m.group(2)})
            continue
        m = ITEM.match(line)
        if m:
            current = new_item(m.group(1), m.group(2), m.group(3), sections[-1]['number'])
            parent = current
            items[current['slug']] = current
            sections[-1]['items'].append(current)
            continue
        m = SUBITEM.match(line)
        if m:
            current = new_item(parent['number'] + m.group(1), m.group(2), m.group(3),
                               parent['section'])
            items[current['slug']] = current
            parent['parts'].append(current)
            continue
        m = WAITS.match(line)
        if m and current is not None:
            current['waits'] += [s.strip() for s in m.group(1).split(',')]
            continue
        m = GOES_WITH.match(line)
        if m and current is not None:
            current['goes_with'] += [s.strip() for s in m.group(1).split(',')]
    return sections, items, foundation


HEADER = ["flowchart BT",
          "  classDef ready fill:#9fd4a8,stroke:#4f9a5d,color:#13261a",
          "  classDef blocked fill:#f1c48b,stroke:#b9853f,color:#2b1d08",
          "  classDef done fill:#c9d3cb,stroke:#8a958c,color:#1f2421"]


def node_lines(work, foundation):
    # ELK starts from the order the nodes come in, and the backlog's own order keeps
    # related items together
    lines = []
    for item in work:
        text = f"§{item['section']} · {item['number']} · {item['title']}"
        lines.append(f"  {node_id(item['slug'])}[{label(text)}]")
    for done in foundation:
        lines.append(f"  {node_id(done['slug'])}[{label(done['title'])}]")
    return lines


def edge_lines(work):
    # Goes with is not drawn: the layout would take it as an edge to rank by
    return [f"  {node_id(waited)} --> {node_id(item['slug'])}"
            for item in work for waited in item['waits']]


def state_lines(work, items, foundation):
    lines = []
    for item in work:
        state = 'blocked' if any(w in items for w in item['waits']) else 'ready'
        lines.append(f"  class {node_id(item['slug'])} {state}")
    for done in foundation:
        lines.append(f"  class {node_id(done['slug'])} done")
    return lines


def draw(sections, items, foundation):
    # A dependency graph and nothing else: every item and the foundation are drawn,
    # and the section an item belongs to is a tag in its label, not a box
    work = [item for item in items.values() if not item['parts']]
    return (HEADER + node_lines(work, foundation) + edge_lines(work)
            + state_lines(work, items, foundation))


def graph_of(text):
    sections, items, foundation = read_backlog(text.split('\n'))
    return '\n'.join(draw(sections, items, foundation))


PAGE = '''<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>Backlog dependencies</title>
<style>html, body {{ margin: 0; height: 100%; overflow: hidden; background: #fff; }} pre.mermaid {{ margin: 0; }}
#find {{ position: fixed; top: 8px; left: 8px; font: 14px sans-serif; }}
#keys {{ position: fixed; bottom: 8px; left: 8px; padding: 4px 8px; font: bold 13px/1.5 sans-serif; color: rgba(0, 0, 0, 0.333); background: rgba(255, 255, 255, 0.8); }}
#keys:hover {{ color: rgba(0, 0, 0, 0.8); }}
g.node.match rect, g.node.match polygon, g.node.match path {{ stroke: #e8590c !important; stroke-width: 3px !important; }}
g.node.current rect, g.node.current polygon, g.node.current path {{ stroke-width: 6px !important; }}</style>
<script src="https://cdn.jsdelivr.net/npm/svg-pan-zoom@3.6.2/dist/svg-pan-zoom.min.js"></script>
</head>
<body>
<div id="find" hidden><input id="search" placeholder="Search"> <span id="count"></span></div>
<div id="keys">+ − zoom<br>← ↑ → ↓ or 4 5 6 2 pan, Shift further<br>0 fit<br>/ search</div>
<pre class="mermaid">
{graph}
</pre>
<script type="module">
import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11.17.2/dist/mermaid.esm.min.mjs';
import elkLayouts from 'https://cdn.jsdelivr.net/npm/@mermaid-js/layout-elk@0.2.3/dist/mermaid-layout-elk.esm.min.mjs';
mermaid.registerLayoutLoaders(elkLayouts);
mermaid.initialize({{ startOnLoad: false, layout: 'elk', flowchart: {{ useMaxWidth: false }} }});
await mermaid.run();
// Drag to pan and scroll to zoom, as in mermaid.live, over the whole window
const svg = document.querySelector('pre.mermaid svg');
svg.removeAttribute('width');
svg.style.maxWidth = 'none';
svg.style.width = '100vw';
svg.style.height = '100vh';
const panZoom = svgPanZoom(svg, {{ controlIconsEnabled: true, fit: true, center: true, minZoom: 0.1, maxZoom: 20 }});
// Type / to search the labels, Enter goes to the next match and Escape closes
const find = document.getElementById('find');
const search = document.getElementById('search');
const count = document.getElementById('count');
let matches = [];
let current = -1;
function centre(node) {{
  const n = node.getBoundingClientRect();
  panZoom.panBy({{ x: window.innerWidth / 2 - (n.left + n.width / 2), y: window.innerHeight / 2 - (n.top + n.height / 2) }});
}}
function next() {{
  matches.forEach(m => m.classList.remove('current'));
  if (matches.length == 0) {{
    count.textContent = search.value ? 'no matches' : '';
    return;
  }}
  current = (current + 1) % matches.length;
  matches[current].classList.add('current');
  count.textContent = (current + 1) + ' of ' + matches.length;
  centre(matches[current]);
}}
search.addEventListener('input', () => {{
  matches.forEach(m => m.classList.remove('match', 'current'));
  const text = search.value.toLowerCase();
  matches = text ? [...svg.querySelectorAll('g.node')].filter(n => n.textContent.toLowerCase().includes(text)) : [];
  matches.forEach(m => m.classList.add('match'));
  current = -1;
  next();
}});
search.addEventListener('keydown', e => {{
  if (e.key == 'Enter')
    next();
  if (e.key == 'Escape') {{
    find.hidden = true;
    search.blur();
  }}
}});
// Keys for the graph, except while typing a search: + and - zoom, the arrows and
// 4, 5, 6 and 2 pan (further with Shift), and 0 fits the whole graph again
const pans = {{ ArrowLeft: [1, 0], ArrowRight: [-1, 0], ArrowUp: [0, 1], ArrowDown: [0, -1],
               4: [1, 0], 6: [-1, 0], 5: [0, 1], 2: [0, -1] }};
document.addEventListener('keydown', e => {{
  if (document.activeElement == search || e.ctrlKey || e.metaKey || e.altKey)
    return;
  const step = e.shiftKey ? 0.5 : 0.1;
  if (e.key == '/') {{
    find.hidden = false;
    search.focus();
    search.select();
  }} else if (e.key == '+' || e.key == '=') {{
    panZoom.zoomIn();
  }} else if (e.key == '-') {{
    panZoom.zoomOut();
  }} else if (e.key == '0') {{
    panZoom.fit();
    panZoom.center();
  }} else if (e.key in pans) {{
    panZoom.panBy({{ x: pans[e.key][0] * step * window.innerWidth, y: pans[e.key][1] * step * window.innerHeight }});
  }} else {{
    return;
  }}
  e.preventDefault();
}});
