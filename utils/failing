#!/bin/bash
# List test directories that have an output file (indicating a failed test)

# Find the root of the project (c-xrefactory)
PROJECT_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
if [[ -z "$PROJECT_ROOT" || "$(basename "$PROJECT_ROOT")" != "c-xrefactory" ]]; then
  echo "Error: Script must be run from within the c-xrefactory project tree." >&2
  exit 1
fi

# A test_* directory without a Makefile is not a test: it is an orphan left
# behind when a test was deleted from git but its generated files kept the
# directory alive. Its stale 'output' would otherwise be reported as a failure
# forever. Same rule as tests/Makefile uses to discover tests.
for dir in "$PROJECT_ROOT/tests/test_"*; do
    if [ -d "$dir" ] && [ -f "$dir/Makefile" ] && [ -f "$dir/output" ] && [ ! -f "$dir/.suspended" ]; then
        basename "$dir"
    fi
done
